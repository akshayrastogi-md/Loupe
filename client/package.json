{
  "name": "loupe-rn",
  "version": "0.1.1",
  "description": "React Native debugger SDK for Loupe: network inspector, WebSockets, TanStack Query, Redux/Zustand state, AsyncStorage, logs and API mocking. Works with Expo.",
  "keywords": [
    "react-native",
    "react-native-debugger",
    "debugger",
    "devtools",
    "network-inspector",
    "network-debugger",
    "http-inspector",
    "api-mocking",
    "flipper-alternative",
    "reactotron-alternative",
    "expo",
    "expo-go",
    "hermes",
    "redux",
    "redux-devtools",
    "zustand",
    "tanstack-query",
    "react-query",
    "react-navigation",
    "websocket",
    "async-storage"
  ],
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "react-native": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/testing.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshayrastogi-md/Loupe.git",
    "directory": "client"
  },
  "homepage": "https://github.com/akshayrastogi-md/Loupe#readme",
  "bugs": {
    "url": "https://github.com/akshayrastogi-md/Loupe/issues"
  }
}
