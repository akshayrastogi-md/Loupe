{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist/esm",
    "declarationDir": "dist/types",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/testing.ts"]
}
